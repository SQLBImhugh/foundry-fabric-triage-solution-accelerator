# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. EVERY value is optional: with none of them set,
# the accelerator runs fully offline against mock tools and a scripted model
# provider. That is how the test suite runs, and how you should evaluate it
# before pointing it at a tenant.
#
# Never commit a filled-in copy of this file.
# ---------------------------------------------------------------------------

# --- Execution mode --------------------------------------------------------
# mock     = scripted deterministic provider, no network. Default.
# direct   = Azure OpenAI chat.completions with function calling.
# foundry  = Azure AI Foundry named agents with connected-agent handoff.
TRIAGE_PROVIDER_MODE=mock

# Which tool implementations to bind. mock = in-memory fakes, live = real REST.
# The two are independent: TRIAGE_TOOL_MODE=live with TRIAGE_PROVIDER_MODE=mock
# is a valid combination (real refreshes, deterministic reasoning).
TRIAGE_TOOL_MODE=mock
# fixture uses explicit synthetic registry state. live requires deployment-owned
# Azure SQL bootstrap and a pinned tenant. Epoch/cutoff are never environment settings.
MONITORING_MODE=fixture
MONITORING_TENANT_ID=
AZURE_CLIENT_ID=

# --- Azure AI Foundry ------------------------------------------------------
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_TRIAGE_AGENT_NAME=bi-triage
FOUNDRY_DQ_AGENT_NAME=bi-data-quality
FOUNDRY_OBSERVER_AGENT_NAME=bi-triage-observer
FOUNDRY_AGENT_MODEL=gpt-5.6-luna
FOUNDRY_GUARDRAIL_NAME=bi-triage-guardrail
# responses = the orchestrator invokes the data quality agent over
#             /openai/v1/responses, so the policy ledger charges the handoff.
# a2a       = Foundry's a2a_preview tool. Requires the callee to be a HOSTED
#             agent speaking the 'a2a' protocol; a prompt agent publishes no
#             agent card and the call fails at card fetch.
FOUNDRY_HANDOFF_MODE=responses

# --- Azure OpenAI (direct mode) --------------------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Microsoft Graph (mailbox ingestion) -----------------------------------
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=bi-alerts@contoso.com
# A mailbox the agent must NOT be able to read. `watch` tries to read it at
# startup and refuses to run if it succeeds, because success means the Exchange
# ApplicationAccessPolicy is missing and app-only Mail.Read is tenant-wide.
GRAPH_CANARY_MAILBOX=
# How mail arrives. Only 'poll' is implemented: a timer reads the mailbox and
# skips anything already triaged, so average latency is half the interval.
# 'subscription' (Graph change notifications) is REJECTED at startup rather
# than silently polling, because believing you have push while getting a poll
# is a latency assumption nothing will correct.
GRAPH_INGESTION_MODE=poll
# Default seconds between polls for `bi-triage watch`; --interval overrides it.
GRAPH_POLL_SECONDS=30

# The inbox filter is a SECURITY CONTROL, not housekeeping. An agent that acts
# on every message it receives is steerable by anyone who can email it. Both
# filters fail closed, including when the pattern below is invalid, and they
# count what they ignored rather than dropping it silently.
#
# Widen these to onboard a real alert sender. Never widen them to make a test
# find something: send a message that matches instead.
GRAPH_SENDER_ALLOWLIST=no-reply-powerbi@microsoft.com,no-reply@powerbi.com
GRAPH_SUBJECT_PATTERN=(?i)\b(power\s*bi|fabric|refresh|semantic model|dataset)\b

# --- Power BI REST ---------------------------------------------------------
POWERBI_CLIENT_ID=

# --- Durable state ---------------------------------------------------------
# An Azure SQL Database on an Entra-only logical server. Use its DNS hostname
# (<server>.database.windows.net) and database name from the Azure deployment.
# Public networking is the deployment default. Admit Azure-hosted callers and
# any reviewed client addresses through the SQL firewall; Entra users/roles
# still control data access. Private endpoints are not a prerequisite.
# Tenant-specific network exceptions belong to the test environment, not here.
#
# Fixture mode keeps offline stores independent. Live mode requires both values
# and the current deployed schema; it never substitutes JSON or runs runtime DDL.
# Live CLI commands require --sql-identity managed or --sql-identity broker
# --operator-domain <domain>. Neither path silently borrows az's current login.
#
# There is no username, password or connection secret here. Deployment enables
# Entra-only authentication; the controller uses its own service identity.
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
DATA_QUALITY_FLAG_TABLE_NAME=triage_data_quality_flags
INCIDENT_TABLE_NAME=triage_incidents
PROCESSED_TABLE_NAME=triage_processed_messages
APPROVAL_TABLE_NAME=triage_approvals
RETRY_TABLE_NAME=triage_deferred_retries
SEMANTIC_HEALTH_TABLE_NAME=triage_semantic_health
# Arbitrates one silent sweep at a time across instances.
LEASE_TABLE_NAME=triage_sweep_leases
# Distributed claims. Two invocations -- a manual invoke overlapping a schedule,
# or two hosted replicas -- could otherwise both see an alert as untriaged and
# both remediate it. Shares the database; only the table differs.
CLAIM_TABLE_NAME=triage_claims
# Evidence of what the inbox filter refused, and why. The filter is a security
# control, and "ignored 10 messages" reads identically whether it is rejecting
# noise or has gone deaf to the real alerts -- the reason column is the
# difference. Append-only and capped; nothing reads these rows back.
INBOX_AUDIT_TABLE_NAME=triage_inbox_audit
PIPELINE_RERUN_TABLE_NAME=triage_pipeline_reruns
AGENT_RUN_TABLE_NAME=triage_agent_runs
AGENT_EVENT_TABLE_NAME=triage_agent_events
AGENT_COMMAND_TABLE_NAME=triage_agent_commands
INCIDENT_ACTIVITY_TABLE_NAME=triage_incident_activity

# --- Human approval --------------------------------------------------------
# Where the approval card's buttons point. Leaving it empty is a valid
# configuration: the card then shows a request id to answer from the CLI.
#
# With no gate configured, every gated action is REFUSED. Silence is never read
# as consent, and neither is a timeout, an error or a malformed reply.
APPROVAL_CALLBACK_URL=
APPROVAL_TIMEOUT_SECONDS=300
# Web decisions are fingerprint/expiry/single-use checked in shared state.
# Use "web" when the command center is deployed; Teams notification is optional.
APPROVAL_DELIVERY_MODE=teams
COMMAND_CENTER_URL=

# --- Teams notification ----------------------------------------------------
TEAMS_WEBHOOK_URL=
# Only 'webhook' works. App-only channel posting through Graph is restricted by
# Microsoft to migration scenarios, so an unattended agent cannot post as
# itself. Anything else is rejected rather than quietly using the webhook.
TEAMS_MODE=webhook
NOTIFICATION_CHANNEL=teams
RUN_HISTORY_ENABLED=false

# --- Observability ---------------------------------------------------------
# Spans carry metadata only. Prompt and completion content is never attached.
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Hosted application metadata only. Foundry owns the standard variable above;
# project tracing is a separate content-collection feature, not a prerequisite.
# Use an Entra-only Application Insights resource and the agent's publisher role.
TRIAGE_TELEMETRY_CONNECTION_STRING=
APP_VERSION=1.0.0

# --- Policy limits (enforced in the controller, not the prompt) -------------
# Budgets are shared across ALL agents in a run, not per agent.
TRIAGE_MAX_LLM_TURNS=14
TRIAGE_MAX_TOOL_CALLS=20
TRIAGE_MAX_WRITE_ACTIONS=1
TRIAGE_MAX_TOKENS=80000
TRIAGE_TIMEOUT_SECONDS=300

# How long the controller may keep admitting heartbeat work, in seconds.
#
# This is the controller's own deadline, not the host's HTTP limit. It must be
# at least TRIAGE_TIMEOUT_SECONDS + APPROVAL_TIMEOUT_SECONDS + 90, because that
# is the allowance one admitted unit may need; a smaller value is refused at
# startup rather than silently admitting nothing for ever.
#
# Check it against what your caller actually waits for. Azure Logic Apps
# Consumption aborts a synchronous outbound request at 120 seconds whatever
# its configured timeout says, so a caller of that shape will cut the heartbeat
# off mid-flight. In-flight work is still protected by its lease, but the
# report is lost.
HEARTBEAT_BUDGET_SECONDS=840

# --- Silent-failure detector -----------------------------------------------
# The failures that send no alert at all: a refresh reports success while the
# source never landed, or a table loads a tenth of its rows. Nothing is emailed,
# so nothing is triaged, and the report is simply wrong until somebody notices.
SILENT_SWEEP_ENABLED=true

# Probe configuration, as JSON. Empty means the detector watches nothing, which
# is the right default: "fresh" is a business question, and guessing it produces
# exactly the false positives that get a detector muted.
#
# expected_lag_hours is how far behind now the data is SUPPOSED to be: 24 for a
# daily model holding yesterday, 96 for T+3 finance data.
#
# SILENT_HEALTH_PROBES=[{"name":"sales-freshness","workspace_id":"<guid>","dataset_id":"<guid>","table":"FactSales","date_column":"BusinessDate","report_name":"Orders Daily Rollup","expected_lag_hours":24,"min_absolute_drop":1000}]
#
# Star schema? The fact table usually holds a date KEY and no date, so point the
# watermark through the relationship instead. Measuring the date dimension
# directly returns the end of the calendar, which is years in the future, and
# the probe would report a stale model as fresh for ever.
#
#   "table":"fact_sales_invoice","date_table":"dim_date","date_column":"date"
#
# "watch_schema":true adds one query per sweep and reports columns or measures
# that disappear. Additions are ignored: models gain columns constantly.
#
# "load_weekdays":[1,2,3,4,5] stops a weekday-only feed reading as stale every
# weekend, which is how a detector earns a filter rule and stops being read.
#
# Check it with `bi-triage health --preflight` before trusting it.
SILENT_HEALTH_PROBES=

# Seconds between probes in one sweep. executeQueries is throttled per user
# across every dataset, so firing them together makes the detector the capacity
# incident it exists to watch for.
SILENT_PROBE_PACE_SECONDS=1.0

# --- Scheduled Fabric pipeline failures ------------------------------------
# Targets, observation policy and replay reviews live in the monitoring registry.
# This does not widen the mailbox filter. The worker owns due REST polling;
# the controller heartbeat drains admitted source work and read-only verification.
FABRIC_CLIENT_ID=
PIPELINE_SWEEP_ENABLED=false
PIPELINE_LOOKBACK_HOURS=24
PIPELINE_MAX_PAGES=10
PIPELINE_MAX_RUNS_PER_SWEEP=1
# Replay safety and complete parameters require a current registry safety review.
# Every rerun still needs fingerprint-matched human approval. Unknown safety is a no.
# See docs/PipelineTriage.md before enabling replay of pipelines with sink writes.

# --- Operator command center ----------------------------------------------
# Demo is local, synthetic and refuses to start on Azure. Live mode requires
# Entra access tokens and command-center permissions; never an API key.
COMMAND_CENTER_MODE=demo
COMMAND_CENTER_TENANT_ID=
COMMAND_CENTER_CLIENT_ID=
COMMAND_CENTER_SCOPE=
COMMAND_CENTER_STATIC_DIR=
COMMAND_CENTER_DEMO_WORKER=true
# "records" explains stored facts without a model; "model" invokes the registered
# read-only observer. Neither path exposes remediation tools.
COMMAND_CENTER_QUESTION_PROVIDER=records
# Enable only for an admin-operated evaluation. The canonical scenario suite
# runs on deployed code with isolated mock tools/state, not real table resets.
COMMAND_CENTER_VALIDATION_ENABLED=false
# Application permissions come from Entra app-role assignments, normally through
# security groups. The retired COMMAND_CENTER_ACCESS_MANAGEMENT_ENABLED flag
# must remain unset/false; there is no SQL membership permission store.
COMMAND_CENTER_ACCESS_MANAGEMENT_ENABLED=false
